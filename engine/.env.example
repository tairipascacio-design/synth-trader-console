# Copia este archivo a engine/.env en el Droplet. Nunca lo subas a GitHub.
PORT=8787
HOST=127.0.0.1
DATA_DIR=/opt/ghost-sweep/engine/data
# 1 = cookie solo por HTTPS (con dominio y certbot). Pon 0 si entras por http://IP.
COOKIE_SECURE=1
# Claves de Binance: aún no se usan (etapa de solo lectura).
BINANCE_API_KEY=
BINANCE_API_SECRET=
