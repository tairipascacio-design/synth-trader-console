{
  "name": "ghost-sweep-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GHOST//SWEEP autonomous liquidity trading engine (Binance Spot + USD\u24c8-M Futures)",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
